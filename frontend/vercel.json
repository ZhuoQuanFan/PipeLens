{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze-repository.py": {
      "maxDuration": 10
    },
    "api/ai-edit.mjs": {
      "maxDuration": 60
    },
    "api/run-python.py": {
      "maxDuration": 10
    }
  }
}
